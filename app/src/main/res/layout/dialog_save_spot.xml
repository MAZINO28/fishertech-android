<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I-save ang Fishing Spot"
            android:textStyle="bold"
            android:textColor="#1E4D6B"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSelectedCoords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 14.4506° N,  120.9358° E"
            android:textColor="#1E4D6B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#E8F4FD"
            android:padding="8dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ilapat ang Boya sa Spot na ito:"
            android:textColor="#1E4D6B"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spinnerBuoys"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/input_bg"
            android:paddingHorizontal="12dp"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pangalan ng Spot"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etSpotName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hal. Paboritong lugar"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="text"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notes (optional)"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etSpotNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hal. Maraming isda dito"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSaveSpot"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="I-SAVE"
            android:backgroundTint="#1E4D6B"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCancelSpot"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="I-cancel"
            android:backgroundTint="#EEEEEE"
            android:textColor="#666666"
            app:cornerRadius="10dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F8F9FA">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:elevation="2dp">
        <include layout="@layout/custom_toolbar"/>
    </androidx.appcompat.widget.Toolbar>

    <!-- Alert banner -->
    <LinearLayout
        android:id="@+id/alertBannerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B71C1C"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_dialog_alert"
            android:layout_marginEnd="8dp" />
        <TextView
            android:id="@+id/tvAlertBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚠️ Buoy alert"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingBottom="90dp">

            <!-- Map Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <FrameLayout
                    android:id="@+id/mapFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/mapPlaceholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ocean_map_sample"
                        android:background="#E0E0E0"
                        android:clickable="true"
                        android:focusable="true" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_gravity="top"
                        android:background="@drawable/top_shadow_gradient" />


                    <!-- Buoy 1 -->
                    <LinearLayout
                        android:id="@+id/buoyContainer1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Boya 1"
                            android:textSize="8sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:background="#CC1E4D6B"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="1dp"
                            android:layout_marginBottom="2dp" />
                        <ImageView
                            android:id="@+id/pinBuoy1"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#FFD700"
                            android:background="@drawable/circle_pin_bg"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Buoy 2 -->
                    <LinearLayout
                        android:id="@+id/buoyContainer2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Boya 2"
                            android:textSize="8sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:background="#CC1E4D6B"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="1dp"
                            android:layout_marginBottom="2dp" />
                        <ImageView
                            android:id="@+id/pinBuoy2"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#FFD700"
                            android:background="@drawable/circle_pin_bg"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Buoy 3 -->
                    <LinearLayout
                        android:id="@+id/buoyContainer3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Boya 3"
                            android:textSize="8sp"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:background="#CC1E4D6B"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="1dp"
                            android:layout_marginBottom="2dp" />
                        <ImageView
                            android:id="@+id/pinBuoy3"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_mylocation"
                            app:tint="#FFD700"
                            android:background="@drawable/circle_pin_bg"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Single red user marker -->
                    <ImageView
                        android:id="@+id/userLocationPin"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_mylocation"
                        app:tint="#E53935"
                        android:visibility="invisible"
                        android:elevation="10dp" />


                    <!-- Map Legend -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="12dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="4dp"
                        app:cardMaxElevation="4dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🟡  Boya"
                                android:textColor="#333333"
                                android:textStyle="bold"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="🔴  Piniling spot"
                                android:textColor="#333333"
                                android:textStyle="bold"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Hint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Mag-tap sa mapa para pumili ng lokasyon"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginBottom="10dp"
                android:layout_gravity="center_horizontal" />

            <!-- Location card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Piniling Lokasyon"
                        android:textStyle="bold"
                        android:textColor="#1E4D6B"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LATITUDE"
                                android:textSize="11sp"
                                android:textColor="#999999" />
                            <TextView
                                android:id="@+id/tvLatitude"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14.4506° N"
                                android:textStyle="bold"
                                android:textColor="#333333"
                                android:textSize="18sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="15dp"
                            android:background="#EEEEEE" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LONGITUDE"
                                android:textSize="11sp"
                                android:textColor="#999999" />
                            <TextView
                                android:id="@+id/tvLongitude"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="120.9358° E"
                                android:textStyle="bold"
                                android:textColor="#333333"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!--
                        ✅ Single button + hidden until map is tapped
                    -->
                    <LinearLayout
                        android:id="@+id/actionButtonsLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="16dp"
                        android:visibility="gone">

                        <Button
                            android:id="@+id/btnSaveSpotAction"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:text="📍 I-SAVE BILANG FISHING SPOT"
                            android:backgroundTint="#1E4D6B"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:textSize="13sp"
                            app:cornerRadius="12dp" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Saved Spots -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mga Na-save na Fishing Spot"
                android:textColor="#1E4D6B"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSpotsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/3 spots saved"
                android:textColor="#999999"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSavedSpots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:menu="@menu/admin_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"/>

</LinearLayout>
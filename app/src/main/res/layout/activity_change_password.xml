<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEDED">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Palitan ang Password"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:layout_marginBottom="25dp"/>

        <EditText
            android:id="@+id/etOldPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Dating Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="15dp"
            android:background="@android:drawable/edit_text"/>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" android:layout_marginBottom="15dp"/>

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Bagong Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="15dp"
            android:background="@android:drawable/edit_text"/>

        <EditText
            android:id="@+id/etConfirmNewPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ulitin ang Bagong Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="25dp"
            android:background="@android:drawable/edit_text"/>

        <Button
            android:id="@+id/btnUpdatePassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="I-UPDATE ANG PASSWORD"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2F5F8F"
            android:textStyle="bold"
            app:cornerRadius="4dp"/>

        <TextView
            android:id="@+id/tvCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I-cancel"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:textColor="#888888"
            android:padding="10dp"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
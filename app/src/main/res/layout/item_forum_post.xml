<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <!-- Wrapper para sa buong bubble para madaling ilipat sa kaliwa o kanan -->
    <LinearLayout
        android:id="@+id/bubbleWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start">

        <LinearLayout
            android:id="@+id/chatBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="280dp"
            android:padding="12dp"
            android:background="@drawable/chat_bubble_left">

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pangalan"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#1E4D6B"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvPostContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mensahe dito"
                android:textSize="15sp"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_gravity="end"
                android:text="2 min ago"
                android:textSize="10sp"
                android:textColor="#777777"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
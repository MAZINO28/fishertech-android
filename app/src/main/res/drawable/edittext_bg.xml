<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color ng input box -->
    <solid android:color="#FFFFFF" />

    <!-- Border color (Light Blue/Gray) -->
    <stroke
        android:width="1dp"
        android:color="#BDBDBD" />

    <!-- Rounded corners para hindi matalas ang kanto -->
    <corners android:radius="8dp" />

    <!-- Padding para hindi dikit ang text sa border -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp" />
</shape>